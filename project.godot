;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Room 727"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

EventBus="*uid://coag0iopyc0pp"
TipTextBus="*uid://dajvhro0cjp18"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[global_group]

interactable="Group for things that can be interacted with the player's raycast."
player="Group for nodes to know if a body is the player."
killedAtOne="Nodes that should be deleted when entering to the 1st phase."
photographable="Able to interact to be fotographed"

